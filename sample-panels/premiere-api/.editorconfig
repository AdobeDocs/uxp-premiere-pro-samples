# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cjs,js,jsx,mjs,ts,tsx}]
indent_size = 2
tab_width = 2

[*.json]
indent_size = 2
tab_width = 2

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.yaml]
indent_style = space
indent_size = 2
